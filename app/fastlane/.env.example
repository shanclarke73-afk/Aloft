# Copy this file to fastlane/.env (git-ignored) and fill it in. Fastlane loads it on every run.
# The key files themselves stay outside the repo.

# App Store Connect API key (Users and Access › Integrations › App Store Connect API).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=/Users/shannonclarke/AppStoreKeys/AuthKey_<KEY ID>.p8

# Google Play service account JSON. The account needs release permissions for Aloft
# in Play Console (Users and permissions).
PLAY_JSON_KEY_PATH=/Users/shannonclarke/AppStoreKeys/taxtote-play-fastlane.json
